#include<stdio.h>

struct student
{
char name[90];
int id;
int age;
int marks;
char dream[90];
 };
int read(struct student s[],int n)
   {
int i;
for(i=0;i<n;i++)
{
printf("\nenter  student details %d: \n", i+1);

printf("\nenter name:\n ");
scanf("%s", s[i].name);

printf("\nenter id:\n ");
scanf("%d",&s[i].id);

printf("\nenter age:\n ");
scanf("%d",&s[i].age);

printf("\nenter marks:\n ");
scanf("%d",&s[i].marks);

printf("\nenter dream:\n ");
scanf("%s",s[i].dream);
}
return 0;
}
void write(struct student s[],int n)
{
int i;
printf("\n----student details----\n");
for(i=0;i<n;i++)
{
printf("\nName: %s\n ",s[i].name);
printf("\nID: %d\n ",s[i].id);
printf("\nAGE: %d\n ",s[i].age);
printf("\nMARKS: %d\n ",s[i].marks);
printf("\nDREAM: %s\n ",s[i].dream);
}
}
int main()
{
struct student s[100];
int n;
printf("enter number of students:\n");
scanf("%d",&n);

  read(s,n);
  write(s,n);
  return 0;
  }